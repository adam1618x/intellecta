generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Admin ────────────────────────────────────────────────────────────────────

model Admin {
  id        Int      @id @default(autoincrement())
  username     String   @unique
  password  String   // bcrypt hash — never plain text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Course Content ─────────────────────────────────────────────────────────────

model Publication {
  id           Int                      @id @default(autoincrement())
  category     String                   // "courses" | "programming" | "mathematics" | "sciences" | "business" | "languages"
  author       String?
  publishedAt  DateTime                 @default(now())
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  translations PublicationTranslation[]
  image        String?
  enrolled     Int                      @default(0)
  completed    Int                      @default(0)
}

model PublicationTranslation {
  id            Int         @id @default(autoincrement())
  locale        String      // "ar" | "en" | "fr" | "ms"
  title         String
  excerpt       String
  content       String      @db.Text
  publicationId Int
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([publicationId, locale])
}

// ─── Contact Messages ─────────────────────────────────────────────────────────

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  locale    String   // locale the visitor used when they submitted
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
// ─── Books ────────────────────────────────────────────────────────────────────

model Book {
  id          Int      @id @default(autoincrement())
  title       String
  author      String?
  description String?  @db.Text
  year        String?
  pages       String?
  downloadUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}